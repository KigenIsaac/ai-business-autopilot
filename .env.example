# Copy to a private environment file; never commit real credentials.
AUTOPILOT_DATA_DIR=/var/lib/ai-business-autopilot
# Choose one LLM provider key:
OPENAI_API_KEY=
OPENROUTER_API_KEY=
LLM_API_KEY=
# Optional: override API base URL/model. Defaults select a provider-compatible model.
LLM_BASE_URL=
LLM_MODEL=
# Search + freelance opportunity discovery:
TAVILY_API_KEY=
SEARCH_API_KEY=
# Google OAuth Web client; Gmail scope is gmail.compose only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://fx.ketronics.co.ke/autopilot/api/gmail/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
